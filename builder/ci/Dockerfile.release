# Omarchy Android release image (aarch64)
#
# Builds the sanitized ARM64 release rootfs entirely inside the container so the
# resulting image is reproducible from this repository alone. No host bind mounts
# are required at build time, which lets the same Dockerfile drive both GitHub
# Actions (via `docker build`) and on-device Termux builders (via `proot-distro
# build`).
#
# Build context must be the project root. The Dockerfile then:
#
#   1. Disables pacman's nested Landlock/seccomp sandbox and installs build +
#      runtime packages.
#   2. Fetches the pinned upstream sources and applies the reviewed Android
#      patch series.
#   3. Compiles Mesa, Aquamarine, and Hyprland against the staged Mesa userspace.
#   4. Drops the compiler closure so the published image retains only the
#      explicit runtime roots declared in runtime-packages.txt.
#   5. Lays down the Omarchy shell, the graphics artifact, the curated Android
#      guest runtime, the default theme, and the system-level service stubs.
#   6. Scrubs package caches, logs, machine identity, shell history, and any
#      Chromium browsing state.
#   7. Writes /etc/omarchy-android-release recording the pinned revisions.
#
# The base image is pinned by digest in manifest/oci-images.lock so a malicious
# or stale tag cannot silently swap the build base.

ARG ARCHLINUXARM_BASE=ghcr.io/btwiuse/arch:base

# syntax=docker/dockerfile:1.7

FROM ${ARCHLINUXARM_BASE}

# Switch to bash with strict flags for the rest of the build. SHELL must come
# after FROM in BuildKit.
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

# Pacman 7's Landlock/seccomp download sandbox cannot nest inside Docker or
# PRoot. Disable only those inner restrictions; the entire builder remains
# confined to the disposable container.
RUN sed -i \
      -e '/^DisableSandboxFilesystem$/d' \
      -e '/^DisableSandboxSyscalls$/d' \
      /etc/pacman.conf \
    && sed -i \
         -e '/^\[options\]$/a DisableSandboxSyscalls' \
         -e '/^\[options\]$/a DisableSandboxFilesystem' \
         /etc/pacman.conf \
    && if ! grep -q '^ParallelDownloads' /etc/pacman.conf; then \
         sed -i '/^\[options\]$/a ParallelDownloads = 4' /etc/pacman.conf; \
       fi \
    && if ! grep -q '^DownloadUser' /etc/pacman.conf; then \
         sed -i '/^\[options\]$/a DownloadUser = root' /etc/pacman.conf; \
       fi \
    && pacman-key --init \
    && pacman-key --populate archlinuxarm \
    && pacman -Syu --noconfirm

COPY builder/guest/packages.txt /tmp/builder/packages.txt
COPY builder/guest/runtime-packages.txt /tmp/builder/runtime-packages.txt
RUN sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' \
        /tmp/builder/packages.txt > /tmp/builder/build.pkgs \
    && sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' \
        /tmp/builder/runtime-packages.txt > /tmp/builder/runtime.pkgs \
    && mapfile -t _pkgs < <(cat /tmp/builder/build.pkgs /tmp/builder/runtime.pkgs) \
    && pacman -S --needed --noconfirm "${_pkgs[@]}" \
    && rm -rf /var/cache/pacman/pkg/* \
    && unset _pkgs

# Pin the trusted upstream sources at the locked revisions and apply the
# reviewed Android patch series. The project root is copied in wholesale so
# `manifest/components.lock` and `manifest/patches.lock` are the single source
# of truth for what gets compiled.
WORKDIR /opt/src
COPY . /opt/src

ENV OMARCHY_BUILD_JOBS=4

RUN /opt/src/scripts/fetch-sources.sh \
      --destination /opt/src/upstream \
      mesa aquamarine hyprland omarchy \
    && git -C /opt/src/upstream/omarchy config user.name 'Omarchy Android Builder' \
    && git -C /opt/src/upstream/omarchy config user.email 'builder@omarchy-android.invalid' \
    && git -C /opt/src/upstream/omarchy am --committer-date-is-author-date \
         /opt/src/patches/omarchy-shell/*.patch \
    && git config --global --add safe.directory /opt/src/upstream/mesa \
    && git config --global --add safe.directory /opt/src/upstream/aquamarine \
    && git config --global --add safe.directory /opt/src/upstream/hyprland

# Build the compiled graphics stack against the staged Mesa so Hyprland and
# Aquamarine always link to the exact Mesa userspace that ships in the image.
# The artifact root is intentionally outside /opt because the base image
# ships an empty /opt directory which build-from-local-forks.sh refuses to
# reuse as a clean-build destination.
RUN mkdir -p /opt/omarchy-android /var/tmp/omarchy-android-sources /var/tmp/omarchy-android-build \
    && OMARCHY_BUILD_JOBS=${OMARCHY_BUILD_JOBS} \
       /opt/src/builder/guest/build-from-local-forks.sh \
         /opt/src \
         /opt/src/upstream \
         /tmp/omarchy-android-artifacts \
         /var/tmp/omarchy-android-sources \
         /var/tmp/omarchy-android-build \
    && install -d -m 0755 /opt/omarchy-android \
    && cp -a /tmp/omarchy-android-artifacts/. /opt/omarchy-android/ \
    && find /var/tmp/omarchy-android-sources /var/tmp/omarchy-android-build -depth -delete \
    && rm -rf /tmp/omarchy-android-artifacts /var/cache/pacman/pkg/* /var/log/pacman.log

# Drop the compiler closure so the published image only retains the explicit
# runtime roots declared in runtime-packages.txt.
RUN /opt/src/builder/guest/prune-release-packages.sh /tmp/builder/runtime-packages.txt

# Lay down the Omarchy shell source, the curated Android guest runtime, the
# checksum-pinned Voxtype binary, the default theme, and the seed home
# directory. assemble-release-rootfs.sh additionally scrubs the result and
# writes /etc/omarchy-android-release.
RUN /opt/src/builder/guest/assemble-release-rootfs.sh \
      /opt/src /opt/src/upstream/omarchy /opt/omarchy-android \
    && rm -rf /opt/src \
    && find /var/cache/pacman/pkg -depth -delete 2>/dev/null || true

CMD ["/bin/bash"]
