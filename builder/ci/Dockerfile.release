# Omarchy Android release image (aarch64)
#
# Builds the sanitized ARM64 release rootfs entirely inside the container so the
# resulting image is reproducible from this repository alone. No host bind mounts
# are required at build time, which lets the same Dockerfile drive both GitHub
# Actions (via `docker build`) and on-device Termux builders (via `proot-distro
# build`).
#
# Build context must be the project root. The Dockerfile runs in two stages:
#
#   toolchain: install compiler + runtime packages, fetch pinned upstream
#     sources, apply the reviewed Android patch series, and compile Mesa,
#     Aquamarine, and Hyprland against the staged Mesa userspace. Drop every
#     compiler dependency before the stage ends.
#
#   runtime:   start from the same base, install only the explicit runtime
#     roots, copy just the graphics artifact and the assembled project overlay
#     out of the toolchain stage, lay down the Omarchy shell and the curated
#     Android guest runtime, scrub the result, and write the release
#     metadata. The compiler toolchain and the .git history of every
#     component are never copied here.
#
# The base image is pinned by digest in manifest/oci-images.lock so a malicious
# or stale tag cannot silently swap the build base.

ARG ARCHLINUXARM_BASE=ghcr.io/btwiuse/arch:base

# syntax=docker/dockerfile:1.7

# ----------------------------------------------------------------------------
# Stage 1: toolchain
# ----------------------------------------------------------------------------
FROM ${ARCHLINUXARM_BASE} AS toolchain

# Switch to bash with strict flags. SHELL must come after FROM in BuildKit.
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

# Pacman 7's Landlock/seccomp download sandbox cannot nest inside Docker or
# PRoot. Disable only those inner restrictions; the entire builder remains
# confined to the disposable container.
RUN sed -i \
      -e '/^DisableSandboxFilesystem$/d' \
      -e '/^DisableSandboxSyscalls$/d' \
      /etc/pacman.conf \
    && sed -i \
         -e '/^\[options\]$/a DisableSandboxSyscalls' \
         -e '/^\[options\]$/a DisableSandboxFilesystem' \
         /etc/pacman.conf \
    && if ! grep -q '^ParallelDownloads' /etc/pacman.conf; then \
         sed -i '/^\[options\]$/a ParallelDownloads = 4' /etc/pacman.conf; \
       fi \
    && if ! grep -q '^DownloadUser' /etc/pacman.conf; then \
         sed -i '/^\[options\]$/a DownloadUser = root' /etc/pacman.conf; \
       fi \
    && pacman-key --init \
    && pacman-key --populate archlinuxarm \
    && pacman -Syu --noconfirm

# Build dependency set (compilers, headers, linkers, generators).
COPY builder/guest/packages.txt /tmp/builder/packages.txt
RUN sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' \
        /tmp/builder/packages.txt > /tmp/builder/build.pkgs \
    && mapfile -t _pkgs < /tmp/builder/build.pkgs \
    && pacman -S --needed --noconfirm "${_pkgs[@]}" \
    && rm -rf /var/cache/pacman/pkg/* \
    && unset _pkgs

# Project source for the build-time scripts and pinned manifest lock files.
# Each directory is copied with a trailing slash so the directory names are
# preserved (COPY on a directory copies its CONTENTS, not the directory).
# lib/ is included so fetch-sources.sh and verify-patches.sh can source
# lib/common.sh and lib/manifest.sh.
WORKDIR /opt/src
COPY manifest /opt/src/manifest/
COPY patches /opt/src/patches/
COPY builder /opt/src/builder/
COPY scripts /opt/src/scripts/
COPY licenses /opt/src/licenses/
COPY lib /opt/src/lib/

ENV OMARCHY_BUILD_JOBS=4

# Trust the upstream checkouts the graphics builder reads from.
RUN git config --global --add safe.directory /opt/src/upstream/mesa \
    && git config --global --add safe.directory /opt/src/upstream/aquamarine \
    && git config --global --add safe.directory /opt/src/upstream/hyprland

# Compile Mesa+Aquamarine+Hyprland against the staged Mesa userspace. The
# graphics artifact lands under /opt/omarchy-android and the source / build
# scratch dirs are deleted before the stage ends. /opt/src/upstream/omarchy
# is kept so runtime stage can copy the patched shell tree.
RUN /opt/src/scripts/fetch-sources.sh \
      --destination /opt/src/upstream \
      mesa aquamarine hyprland omarchy \
    && git -C /opt/src/upstream/omarchy config user.name 'Omarchy Android Builder' \
    && git -C /opt/src/upstream/omarchy config user.email 'builder@omarchy-android.invalid' \
    && git -C /opt/src/upstream/omarchy am --committer-date-is-author-date \
         /opt/src/patches/omarchy-shell/*.patch \
    && OMARCHY_BUILD_JOBS=${OMARCHY_BUILD_JOBS} \
       /opt/src/builder/guest/build-from-local-forks.sh \
         /opt/src \
         /opt/src/upstream \
         /opt/omarchy-android \
         /var/tmp/omarchy-android-sources \
         /var/tmp/omarchy-android-build \
    && find /var/tmp/omarchy-android-sources /var/tmp/omarchy-android-build -depth -delete \
    && rm -rf /var/cache/pacman/pkg/* /var/log/pacman.log

# ----------------------------------------------------------------------------
# Stage 2: runtime
# ----------------------------------------------------------------------------
FROM ${ARCHLINUXARM_BASE} AS runtime

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

# Disable pacman's nested sandbox for the same reason as the toolchain stage.
RUN sed -i \
      -e '/^DisableSandboxFilesystem$/d' \
      -e '/^DisableSandboxSyscalls$/d' \
      /etc/pacman.conf \
    && sed -i \
         -e '/^\[options\]$/a DisableSandboxSyscalls' \
         -e '/^\[options\]$/a DisableSandboxFilesystem' \
         /etc/pacman.conf \
    && if ! grep -q '^ParallelDownloads' /etc/pacman.conf; then \
         sed -i '/^\[options\]$/a ParallelDownloads = 4' /etc/pacman.conf; \
       fi \
    && if ! grep -q '^DownloadUser' /etc/pacman.conf; then \
         sed -i '/^\[options\]$/a DownloadUser = root' /etc/pacman.conf; \
       fi \
    && pacman-key --init \
    && pacman-key --populate archlinuxarm \
    && pacman -Syu --noconfirm

COPY builder/guest/runtime-packages.txt /tmp/builder/runtime-packages.txt
RUN sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' \
        /tmp/builder/runtime-packages.txt > /tmp/builder/runtime.pkgs \
    && mapfile -t _pkgs < /tmp/builder/runtime.pkgs \
    && pacman -S --needed --noconfirm "${_pkgs[@]}" \
    && rm -rf /var/cache/pacman/pkg/* \
    && unset _pkgs

# Pull the prebuilt graphics artifact and the patched Omarchy shell out of the
# toolchain stage. No compilers, no .git history, no Meson/CMake caches cross
# over. The /opt/src source tree is also brought across because the assembly
# scripts read manifest/* and patches/* from it.
COPY --from=toolchain /opt/omarchy-android /opt/omarchy-android
COPY --from=toolchain /opt/src/upstream/omarchy /tmp/omarchy-shell
COPY --from=toolchain /opt/src /opt/src

# Drop the compiler closure so the published image only retains the explicit
# runtime roots declared in runtime-packages.txt. assemble-release-rootfs.sh
# also performs the final scrub and writes /etc/omarchy-android-release.
RUN /opt/src/builder/guest/prune-release-packages.sh /tmp/builder/runtime-packages.txt \
    && /opt/src/builder/guest/assemble-release-rootfs.sh \
         /opt/src /tmp/omarchy-shell /opt/omarchy-android \
    && rm -rf /opt/src /tmp/omarchy-shell /tmp/builder \
    && find /var/cache/pacman/pkg -depth -delete 2>/dev/null || true

CMD ["/bin/bash"]