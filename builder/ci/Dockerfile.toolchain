# Omarchy Android toolchain image (aarch64)
#
# Intermediate build product: the locked base image plus the compiler
# closure, the fetched upstream checkouts, and the compiled graphics artifact
# staged at /opt/omarchy-android. The precompile workflow builds this image
# and pushes it to GHCR as :precompile so the release workflow can run a
# thin final-stage layer (Dockerfile.release) on top of it without paying
# the multi-hour Mesa/Hyprland build cost again.
#
# The base image is pinned by digest in manifest/oci-images.lock so a
# malicious or stale tag cannot silently swap the build base.

ARG ARCHLINUXARM_BASE=ghcr.io/btwiuse/arch:base-aarch64

# syntax=docker/dockerfile:1.7

FROM --platform=${TARGETPLATFORM} ${ARCHLINUXARM_BASE}

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

# Pacman 7's Landlock/seccomp download sandbox cannot nest inside Docker.
COPY builder/ci/prepare-pacman-conf.sh /tmp/builder/prepare-pacman-conf.sh
RUN /tmp/builder/prepare-pacman-conf.sh \
    && pacman-key --init \
    && pacman-key --populate archlinuxarm \
    && pacman -Syu --noconfirm

# Build dependency set (compilers, headers, linkers, generators).
COPY builder/guest/packages.txt /tmp/builder/packages.txt
COPY builder/ci/install-pkg-list.sh /tmp/builder/install-pkg-list.sh
RUN /tmp/builder/install-pkg-list.sh /tmp/builder/packages.txt

# Project source for the build-time scripts and pinned manifest lock files.
# Each directory is copied with a trailing slash so the directory names are
# preserved (COPY on a directory copies its CONTENTS, not the directory).
# lib/ is included so fetch-sources.sh can source lib/common.sh and
# lib/manifest.sh.
WORKDIR /opt/src
COPY manifest /opt/src/manifest/
COPY builder /opt/src/builder/
COPY scripts /opt/src/scripts/
COPY licenses /opt/src/licenses/
COPY lib /opt/src/lib/

ENV OMARCHY_BUILD_JOBS=4
# Pinned by build-from-local-forks.sh historically; exported here so the
# per-phase build-graphics.sh RUN steps below see the same value across
# separate `bash -c` invocations (each RUN is its own shell).
ENV OMARCHY_GLAZE_REVISION=b518eec7a22e56ffa238b072c07f47efa7cea97f

# Trust the upstream checkouts the graphics builder reads from.
RUN git config --global --add safe.directory /opt/src/upstream/mesa \
    && git config --global --add safe.directory /opt/src/upstream/aquamarine \
    && git config --global --add safe.directory /opt/src/upstream/hyprland

# Fetch the three component checkouts at their pinned revisions and lay
# them down under /opt/src/upstream. This is a network-only step; no
# compiler work, so it stays under a few seconds.
RUN /opt/src/scripts/fetch-sources.sh \
      --destination /opt/src/upstream \
      mesa aquamarine hyprland

# Materialize writable source trees and initialize Hyprland's submodules.
# This is also a quick step.
RUN OMARCHY_UPSTREAM_ROOT=/opt/src/upstream \
    /opt/src/builder/guest/build-from-local-forks.sh \
      /opt/src \
      /opt/src/upstream \
      /opt/omarchy-android \
      /var/tmp/omarchy-android-sources \
      /var/tmp/omarchy-android-build

# Build each graphics component in its own RUN step. Each step sinks its
# stdout and stderr to a per-phase log under the build root (see
# build-graphics.sh) so buildkit's bounded frontend pipe is never
# saturated by hundreds of thousands of CMake/meson progress lines. Layers
# are cached independently, so a fix to one phase only forces that phase
# to be re-executed on the next build.
RUN OMARCHY_BUILD_JOBS=${OMARCHY_BUILD_JOBS} \
    /opt/src/builder/guest/build-graphics.sh mesa \
        /var/tmp/omarchy-android-sources/mesa \
        /var/tmp/omarchy-android-sources/aquamarine \
        /var/tmp/omarchy-android-sources/hyprland \
        /opt/omarchy-android \
        /var/tmp/omarchy-android-build
RUN OMARCHY_BUILD_JOBS=${OMARCHY_BUILD_JOBS} \
    /opt/src/builder/guest/build-graphics.sh aquamarine \
        /var/tmp/omarchy-android-sources/mesa \
        /var/tmp/omarchy-android-sources/aquamarine \
        /var/tmp/omarchy-android-sources/hyprland \
        /opt/omarchy-android \
        /var/tmp/omarchy-android-build
RUN OMARCHY_BUILD_JOBS=${OMARCHY_BUILD_JOBS} \
    /opt/src/builder/guest/build-graphics.sh hyprland \
        /var/tmp/omarchy-android-sources/mesa \
        /var/tmp/omarchy-android-sources/aquamarine \
        /var/tmp/omarchy-android-sources/hyprland \
        /opt/omarchy-android \
        /var/tmp/omarchy-android-build
RUN /opt/src/builder/guest/build-graphics.sh audit \
        /var/tmp/omarchy-android-sources/mesa \
        /var/tmp/omarchy-android-sources/aquamarine \
        /var/tmp/omarchy-android-sources/hyprland \
        /opt/omarchy-android \
        /var/tmp/omarchy-android-build
RUN /opt/src/builder/guest/build-graphics.sh checksums \
        /var/tmp/omarchy-android-sources/mesa \
        /var/tmp/omarchy-android-sources/aquamarine \
        /var/tmp/omarchy-android-sources/hyprland \
        /opt/omarchy-android \
        /var/tmp/omarchy-android-build

# Drop the source and build scratch dirs and pacman cache now that the
# staged artifact and its checksums are in place under /opt/omarchy-android.
# /opt/src/upstream/omarchy is dropped too — the release stage fetches
# it fresh from the canonical remote, so carrying it through the precompile
# image only bloats layers with a stale checkout.
RUN find /var/tmp/omarchy-android-sources /var/tmp/omarchy-android-build /opt/src/upstream/omarchy -depth -delete \
    && rm -rf /var/cache/pacman/pkg/* /var/log/pacman.log

CMD ["/bin/bash"]